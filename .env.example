# Copy this file to .env for local use. Keep .env private and never commit it.
NODE_ENV=development
DATABASE_MODE=supabase
SUPABASE_DB_URL=
AUTH_DATA_DIR=.local-data

# Resend: verify the sender domain in Resend before setting EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
# Set this to the URL users can reach (your temporary tunnel URL or production URL).
APP_URL=http://127.0.0.1:8001

# Optional instrument-shop checkout. Keep the Paystack secret on the server only.
PAYSTACK_SECRET_KEY=

# Optional TURN REST credentials for WebRTC calls (for coturn use --use-auth-secret).
# The app signs one-hour, per-user credentials; never put the TURN shared secret in the browser.
TURN_URLS=
TURN_SHARED_SECRET=

# Optional Google sign-in. Leave blank to hide the Google sign-in buttons.
GOOGLE_CLIENT_ID=

# Legacy PostgreSQL connection setting. Prefer SUPABASE_DB_URL for Supabase.
DATABASE_URL=
# Keep AUTH_PEPPER stable for a remote database.
AUTH_PEPPER=
# Optional: a stable 32-byte key in 64-character hex or 43-character base64url.
BACKUP_ENCRYPTION_KEY=
